{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carelink",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "tools/cloudflare/worker-entry.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "VERCEL_ENV": "production",
    "CARELINK_EDGE": "cloudflare"
  },
  "secrets": {
    "required": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "SUPABASE_SERVICE_ROLE_KEY",
      "CRON_SECRET",
      "ADMIN_COOKIE_SECRET"
    ]
  },
  "images": {
    "binding": "IMAGES"
  }
}
