{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carelink-local-migration-check",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/_next/static/*",
      "!/*/_next/static/*"
    ]
  },
  "workers_dev": false,
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "",
    "NEXT_PUBLIC_BASE_URL": "",
    "THREADS_USER_ID": "",
    "SALON_REGISTRATION_V2_ENABLED": "false"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "CRON_SECRET",
      "ADMIN_COOKIE_SECRET"
    ]
  }
}
