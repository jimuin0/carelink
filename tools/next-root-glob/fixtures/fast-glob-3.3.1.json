[
  {
    "pattern": "apps/*",
    "matches": [
      "apps/a",
      "apps/b",
      "apps/linked",
      "apps/skip"
    ]
  },
  {
    "pattern": "apps/{a,b}",
    "matches": [
      "apps/a",
      "apps/b"
    ]
  },
  {
    "pattern": "apps/+(a|b)",
    "matches": [
      "apps/a",
      "apps/b"
    ]
  },
  {
    "pattern": "apps/**",
    "matches": [
      "apps/a",
      "apps/a/pages",
      "apps/b",
      "apps/b/app",
      "apps/linked",
      "apps/linked/pages",
      "apps/skip"
    ]
  },
  {
    "pattern": "apps/.hidden",
    "matches": [
      "apps/.hidden"
    ]
  },
  {
    "pattern": "apps/linked",
    "matches": [
      "apps/linked"
    ]
  },
  {
    "pattern": "missing",
    "matches": []
  },
  {
    "pattern": "apps/a",
    "matches": [
      "apps/a"
    ]
  },
  {
    "pattern": "apps/a/",
    "matches": [
      "apps/a/"
    ]
  },
  {
    "pattern": "apps",
    "matches": [
      "apps"
    ]
  },
  {
    "pattern": "apps/**/",
    "matches": [
      "apps/a",
      "apps/a/pages",
      "apps/b",
      "apps/b/app",
      "apps/linked",
      "apps/linked/pages",
      "apps/skip"
    ]
  },
  {
    "pattern": "!apps/skip",
    "matches": []
  },
  {
    "pattern": [
      "apps/*",
      "!apps/skip"
    ],
    "matches": [
      "apps/a",
      "apps/b",
      "apps/linked"
    ]
  },
  {
    "pattern": "./apps/*",
    "matches": [
      "./apps/a",
      "./apps/b",
      "./apps/linked",
      "./apps/skip"
    ]
  },
  {
    "pattern": "./apps/a",
    "matches": [
      "./apps/a"
    ]
  },
  {
    "pattern": "apps/../packages/*",
    "matches": [
      "apps/../packages/bar",
      "apps/../packages/foo"
    ]
  },
  {
    "pattern": "apps/{a,b}/**",
    "matches": [
      "apps/a/pages",
      "apps/b/app"
    ]
  },
  {
    "pattern": "apps/!(skip)",
    "matches": [
      "apps/.hidden",
      "apps/a",
      "apps/b",
      "apps/linked"
    ]
  },
  {
    "pattern": "apps/**/pages",
    "matches": [
      "apps/a/pages",
      "apps/linked/pages"
    ]
  }
]
