# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (.env.example のみテンプレートとして commit、他は全て無視)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stryker / mutation testing
.stryker-tmp/
reports/mutation/

# claude code
# ⚠️ `.claude/` とディレクトリ指定にすると git が中へ降りず、配下の `!` 例外が効かない（git の仕様）。
#    skills だけ全セッション共有で使いたいので `.claude/*` + `!.claude/skills/` の形にする
#    （soel / imakra / karusaku-emr と同じパターン・2026-08-09）。
.claude/*
!.claude/skills/

# playwright (E2E 成果物・ローカル/CI生成物)
/playwright-report/
/test-results/

# Playwright admin E2E auth storageState (session token・コミット禁止)
e2e/.auth/
