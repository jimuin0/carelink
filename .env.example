# Supabase（必須）
NEXT_PUBLIC_SUPABASE_URL=https://xzafxiupbflvgbarrihe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 本番URL（省略時: https://carelink-jp.com）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Slack 通知（Phase 7a: Bot Token + chat.postMessage 方式）
# carelinkBot Slack App → OAuth & Permissions の Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# 既定の投稿先 channel ID（Slack でチャンネル右クリック → コピー → リンク 末尾 C0XXXXXXX）
SLACK_DEFAULT_CHANNEL=C0YOURCHANNELID
# carelinkBot App の Basic Information → App Credentials → Signing Secret
# Phase 7b interactivity（ボタン）用、現状未使用だが先行登録推奨
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# LINE OAuth（省略時: LINEログイン無効）
NEXT_PUBLIC_LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE Messaging API（省略時: LINE通知・Webhook無効）
LINE_CHANNEL_ACCESS_TOKEN_CARELINK=your_line_channel_access_token
LINE_CHANNEL_SECRET_CARELINK=your_line_channel_secret_carelink

# メール送信（省略時: メール送信スキップ）
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=CareLink <noreply@carelink-jp.com>

# ニュースレター（NEWSLETTER_EMAIL_FROM 省略時: CareLink <newsletter@carelink-jp.com>）
# NEWSLETTER_EMAIL_FROM=CareLink <newsletter@carelink-jp.com>
# 配信停止リンクの HMAC 署名鍵（一度設定したら変更しない）
NEWSLETTER_UNSUBSCRIBE_SECRET=your_newsletter_unsubscribe_secret_here
# 運営向けメール通知の宛先（カンマ区切り可・省略時: 送信しない）
# OPERATOR_NOTIFY_EMAIL=ops@example.com

# Cron 認証（Render Cron Jobs → /api/cron/* の Bearer。省略時: 全 cron が 500）
CRON_SECRET=your_cron_secret_here

# /admin メンバーシップキャッシュの HMAC 署名鍵（省略時: キャッシュ無効＝毎回 DB 確認）
ADMIN_COOKIE_SECRET=your_admin_cookie_secret_here

# 運用・監視（省略時: /api/alert-check は 500・管理画面ハートビートは送信しない）
# ALERT_CHECK_TOKEN=your_alert_check_token_here
# ADMIN_HEARTBEAT_URL=https://example.com/heartbeat
# ADMIN_HEARTBEAT_TOKEN=your_admin_heartbeat_token_here

# サイトの URL（リダイレクト・OGP・sitemap 等）
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI サポート（省略時: AI 機能を出さない）・AI 共有24時間上限（省略時: 100）
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# AI_CHAT_DAILY_REQUEST_LIMIT=100

# reCAPTCHA（省略時: 検証をスキップ。本番で AI 機能を開くにはサーバー側の鍵が必須）
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# LINE LIFF・LINE Login（省略時: LINE の項目・LINE ログインを出さない）
# NEXT_PUBLIC_LIFF_ID=your_liff_id_here
# LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here

# LINE WORKS 連携（省略時: LINE WORKS 通知なし）
# LINE_WORKS_BOT_ID=your_line_works_bot_id_here
# LINE_WORKS_CLIENT_ID=your_line_works_client_id_here
# LINE_WORKS_CLIENT_SECRET=your_line_works_client_secret_here
# LINE_WORKS_SERVICE_ACCOUNT=your_line_works_service_account_here
# LINE_WORKS_PRIVATE_KEY=your_line_works_private_key_here

# Google カレンダー連携（省略時: 連携を出さない）
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 受付 v2 の段階導入フラグ（省略時: 無効。release gate が揃うまで true にしない）
# SALON_REGISTRATION_V2_ENABLED=false

# Web Push通知 - VAPID（省略時: Push通知無効）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# アナリティクス（省略時: 読み込みスキップ）
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Google Search Console apex プロパティ用認証トークン（任意）
# 既存wwwプロパティの認証はlayout.tsxにハードコード済み
# apexプロパティ追加時、GSC「HTMLタグ」方式で取得したcontent値をここに設定
# NEXT_PUBLIC_GSC_VERIFICATION_APEX=xxxxxxxxxxxxxxxxxxxxxxx

# Google Maps / Places API キー（GBP管理ページ: 施設情報取得・スコア計算・口コミ表示・評価同期Cron）
# Google Cloud Console → APIとサービス → 認証情報 → APIキー作成 → Places API を有効化
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Threads（https://www.threads.net/）自動投稿（省略時: 投稿を skip・エラーにはしない）
# アクセストークンはここ（環境変数）には置かない。src/lib/threads.ts が読むのは
# THREADS_USER_ID だけで、アクセストークン本体は DB の threads_credentials テーブルに入れる。
# 理由: Threads の長期トークンは60日で失効し、cron（refreshThreadsToken）が定期的に
# 自動更新する。env はデプロイのたびにしか更新できず自動更新の書き戻し先にできないため、
# 更新可能な DB 側に置く（60日を過ぎると自動更新もできなくなり手動再認可が必要）。
THREADS_USER_ID=your_threads_user_id_here
