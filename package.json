{
  "name": "carelink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --ci --coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageReporters=json-summary",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:security": "playwright test e2e/security.spec.ts",
    "test:e2e:perf": "playwright test e2e/performance.spec.ts",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:load": "k6 run load-tests/search-load.js",
    "test:load:soak": "k6 run load-tests/soak-test.js",
    "test:load:booking": "k6 run load-tests/concurrent-booking.js",
    "test:all": "npm run test:ci && npm run test:e2e",
    "prepare": "husky",
    "test:contract": "jest --config=jest.config.contract.js",
    "prelint": "node scripts/ensure-eslint-plugin-link.mjs",
    "pretest": "node scripts/ensure-eslint-plugin-link.mjs",
    "postinstall": "node scripts/ensure-eslint-plugin-link.mjs",
    "lint:debt": "node scripts/check-react-compiler-debt.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fontsource-variable/noto-serif-jp": "5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@line/liff": "^2.29.0",
    "@next/third-parties": "^16.2.1",
    "@react-map/japan": "^1.0.10",
    "@resvg/resvg-wasm": "2.6.2",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.8.1",
    "resend": "^6.9.4",
    "sharp": "^0.35.5",
    "stripe": "^22.3.0",
    "undici": "7.30.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@carelink/next-root-glob": "file:tools/next-root-glob",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "deepmerge": "file:tools/deepmerge",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-carelink-safety": "file:eslint-plugin-carelink-safety",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "minimatch": "file:tools/minimatch-v3-compat",
    "postcss": "^8.5.26",
    "semver": "7.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "axios": "1.20.0",
    "postcss": "$postcss",
    "qs": "^6.17.0",
    "sharp": "^0.35.5",
    "brace-expansion@<3": "^2.1.7",
    "fast-uri": "^3.1.9",
    "js-yaml": "^4.3.2",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.29.0",
    "postcss-selector-parser": "^6.1.3",
    "nanoid": "^3.3.17",
    "follow-redirects": "^1.16.2",
    "minimatch@<4": "$minimatch",
    "minimatch@>=4 <11.0.1": "^11.0.3",
    "glob": "^14.0.3",
    "test-exclude@<7": "^7.0.2",
    "@next/eslint-plugin-next@16.3.0": {
      "fast-glob": "file:../../../tools/next-root-glob"
    }
  },
  "lint-staged": {
    "*": [
      "gitleaks protect --staged --redact --no-banner"
    ]
  }
}
